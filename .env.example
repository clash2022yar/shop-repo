APP_NAME="دیجی‌نو"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR
APP_TIMEZONE=Asia/Tehran

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# SQLite keeps the project runnable with zero setup.
# Switch DB_CONNECTION to mysql/pgsql and fill in the rest for a real server.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=digino
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@digino.com"
MAIL_FROM_NAME="${APP_NAME}"

# Payment gateway (leave empty to use the built-in offline/manual flow)
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# SMS provider for login one-time codes (optional)
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
